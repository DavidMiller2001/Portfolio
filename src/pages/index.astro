---
import Layout from '../layouts/Layout.astro';
import placeholder from '../assets/placeholder.svg';

const projects = [
  {
    title: 'Finance Dashboard',
    description:
      'A personal finance app for tracking transactions, viewing charts, and managing spending data.',
    tags: ['React', 'TanStack Start', 'Drizzle', 'SQLite'],
    liveHref: '#',
    repoHref: 'https://github.com/your-username/finance-dashboard',
    image: placeholder,
  },
  {
    title: 'Ray Tracer',
    description:
      'A JavaScript ray tracer that renders reflective spheres using recursive ray tracing.',
    tags: ['JavaScript', 'Canvas', 'Graphics'],
    liveHref: '#',
    repoHref: 'https://github.com/your-username/ray-tracer',
    image: placeholder,
  },
  {
    title: 'Motivation App',
    description:
      'A web app focused on daily motivation, goal tracking, and productivity.',
    tags: ['Astro', 'TypeScript', 'CSS'],
    liveHref: '#',
    repoHref: 'https://github.com/your-username/motivation-app',
    image: placeholder,
  },
];
---

<Layout>
  <nav class="mx-auto flex w-full max-w-5xl items-center justify-between px-4 py-5">
    <a href="/" class="text-xl font-semibold tracking-tight">
      David Miller
    </a>

    <ul class="flex items-center gap-2 text-sm font-medium">
      <li>
        <a href="https://github.com/your-username" class="nav-link" target="_blank" rel="noopener" aria-label="GitHub">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.73.5.5 5.73.5 12a11.5 11.5 0 0 0 7.84 10.96c.57.1.78-.25.78-.55 0-.27-.01-1.12-.02-2.02-3.19.69-3.86-1.54-3.86-1.54-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.75 1.18 1.75 1.18 1.03 1.77 2.7 1.26 3.36.96.1-.74.4-1.26.72-1.55-2.55-.29-5.23-1.27-5.23-5.66 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.45.11-3.02 0 0 .97-.31 3.18 1.17a11.03 11.03 0 0 1 5.79 0c2.2-1.48 3.17-1.17 3.17-1.17.62 1.57.23 2.73.11 3.02.74.8 1.17 1.82 1.17 3.07 0 4.41-2.69 5.37-5.25 5.65.41.36.77 1.08.77 2.18 0 1.57-.01 2.83-.01 3.22 0 .3.2.66.79.55A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z"/></svg>
        </a>
      </li>
      <li>
        <a href="https://www.linkedin.com/in/your-username" class="nav-link" target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5C3.88 3.5 3 4.38 3 5.48c0 1.1.88 1.98 1.98 1.98 1.1 0 1.98-.88 1.98-1.98C6.96 4.38 6.08 3.5 4.98 3.5zM3.5 8.99h3v12.01h-3V8.99zM9.5 8.99h2.87v1.64h.04c.4-.76 1.38-1.56 2.85-1.56 3.05 0 3.61 2.01 3.61 4.63v6.3h-3V15.1c0-1.4-.03-3.21-1.96-3.21-1.96 0-2.26 1.53-2.26 3.1v5.01h-3V8.99z"/></svg>
        </a>
      </li>
    </ul>
  </nav>

  <main class="mx-auto w-full max-w-5xl px-4 pb-16">
    <section class="flex min-h-[60vh] flex-col items-center justify-center gap-6 text-center">
      <!-- Replace this div with an img later -->
      <div class="profile-placeholder">
        DM
      </div>

      <div class="max-w-2xl">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-(--color-indigo-bloom-600)">
          Front-end Developer
        </p>

        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
          Building polished web experiences with React.
        </h1>

        <p class="mx-auto mt-5 max-w-xl text-lg text-(--color-wisteria-800)">
          I&apos;m David Miller, a front-end developer based in Mount Pleasant, MI. I am currently studying for a degree in IT & Cybersecurity. I first started programming in 2019 but later found my passion for web development during the pandemic.
        </p>
      </div>

    </section>

    <section id="projects" class="scroll-mt-8">
      <div class="mb-6">
        <p class="section-label">Selected work</p>
        <h2 class="text-3xl font-bold tracking-tight">Projects</h2>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((project) => (
          <article class="project-card">
            <img src='/src/assets/placeholder.svg' alt={`${project.title} screenshot`} class="w-full h-40 object-cover rounded-md mb-4" />

            <h3 class="text-xl font-semibold">{project.title}</h3>

            <p class="mt-3 text-sm leading-6 text-(--color-wisteria-800)">
              {project.description}
            </p>

            <ul class="mt-5 flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <li class="project-tag">{tag}</li>
              ))}
            </ul>

            <div class="mt-6 flex gap-3">
              {project.liveHref && (
                <a href={project.liveHref} class="button-primary" target="_blank" rel="noopener">Live demo</a>
              )}

              {project.repoHref && (
                <a href={project.repoHref} class="button-secondary" target="_blank" rel="noopener">Source</a>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>